# gzspay 环境变量示例
# 复制为 .env 后按需修改；.env 不提交到仓库。

# ---------- 基础 ----------
NODE_ENV=development
PORT=3000
# 前端访问地址（OAuth 回调后跳回）。生产环境必须是 https://
APP_BASE_URL=http://localhost:5173
# 后端对外地址（用于拼接 OAuth 回调地址）。生产环境必须是 https://
PUBLIC_BASE_URL=http://localhost:5173
# 额外的写请求来源白名单（逗号分隔，仅需要从局域网地址访问开发预览时填写）
# 例如：http://192.168.1.10:5173,http://gzspay.local:5173
EXTRA_ALLOWED_ORIGINS=
# SQLite 数据文件路径（相对启动目录或绝对路径）
DATABASE_PATH=data/gzspay.sqlite
# 上传目录（校园卡/收款码等需要落盘的文件）
UPLOAD_DIR=data/uploads

# 会话签名/加密密钥。生产环境必须是随机串且至少 32 个字符，否则服务拒绝启动
# 生成方式：openssl rand -hex 32
SESSION_SECRET=please-change-me-to-a-long-random-string
# 会话有效期（天）
SESSION_TTL_DAYS=7
# 反向代理层数：默认生产信任 1 层（Nginx），开发直连为 false。
# 直接用 Node 监听公网时务必设为 false，否则 X-Forwarded-For 可被伪造
TRUST_PROXY=1

# ---------- 校园墙 Campux OAuth ----------
# 在校园墙后台创建 OAuth 应用后填写
CAMPUX_BASE_URL=https://campux.example.com
# 服务端调用校园墙接口（token / userinfo / revoke）用的地址；留空表示与 CAMPUX_BASE_URL 相同。
# 浏览器能打开校园墙、但服务器无法直连其公网入口时（例如容器部署在内网、入口只能从外部访问），
# 这里填集群内地址，如 http://campux-admin.campux.svc.cluster.local:8989
CAMPUX_INTERNAL_BASE_URL=
CAMPUX_CLIENT_ID=
CAMPUX_CLIENT_SECRET=
# 必须与校园墙后台登记的 redirectUris 完全一致
CAMPUX_REDIRECT_URI=http://localhost:3000/api/auth/callback
# 期望的校园墙 tenant id（留空表示不校验）
CAMPUX_TENANT_ID=
# 授权链接使用的 scope
CAMPUX_SCOPE=profile

# ---------- 头像 ----------
# 按 QQ 号拉取 QQ 头像的接口模板；{qq} 会被替换（不记录日志）
QQ_AVATAR_URL_TEMPLATE=https://q1.qlogo.cn/g?b=qq&nk={qq}&s=100
AVATAR_DIR=data/avatars

# ---------- 邮件 SMTP ----------
# 留空时进入开发模式：邮件写入 mail_outbox 表并在控制台输出
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=gzspay <no-reply@gzspay.local>

# ---------- 安全与风控 ----------
# 支付密码连续错误锁定时间（分钟）
PAYMENT_LOCK_MINUTES=30
# 支付密码最大连续错误次数
PAYMENT_MAX_ATTEMPTS=5
# 单笔金额上限（分）
ORDER_MAX_AMOUNT_CENTS=500000
# 每日下单金额上限（分）
DAILY_MAX_AMOUNT_CENTS=2000000
# 转账单笔上限（分，默认 200 元）；只统计「转账」订单，不影响商家订单
TRANSFER_MAX_AMOUNT_CENTS=20000
# 转账当日累计上限（分，默认 1000 元，按本地自然日统计）
TRANSFER_DAILY_MAX_AMOUNT_CENTS=100000
# 邮箱验证码有效期（分钟）与重发间隔（秒）
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# ---------- 限流（每分钟，0 表示关闭对应限流） ----------
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_CALLBACK_PER_MINUTE=30
RATE_LIMIT_ORDER_PER_MINUTE=30
RATE_LIMIT_TRANSFER_PER_MINUTE=10
RATE_LIMIT_SCAN_PER_MINUTE=30
RATE_LIMIT_EMAIL_PER_MINUTE=5
RATE_LIMIT_DYNAMIC_PER_MINUTE=20

# 内网部署且没有 https 证书时设为 1，允许 APP_BASE_URL / PUBLIC_BASE_URL 使用 http
ALLOW_INSECURE_BASE_URL=0

# ---------- 严重系统错误主动告警 ----------
# 可选：接收 JSON POST 的 Webhook（企业微信 / 钉钉 / 飞书群机器人等），留空表示不推送
# 载荷：{ event:"system_error", scope, message, context, stack, suppressed, environment, version, occurredAt }
ALERT_WEBHOOK_URL=
# Webhook 超时（毫秒）
ALERT_WEBHOOK_TIMEOUT_MS=5000
# 是否通过邮件通知「已绑定邮箱的管理员」（需要先配置 SMTP）
ALERT_EMAIL_ENABLED=1
# 同一类错误在该窗口内只告警一次（分钟），期间重复出现的次数合并到下一次
ALERT_THROTTLE_MINUTES=10
# 每小时最多主动告警次数，避免故障期间刷屏
ALERT_MAX_PER_HOUR=30

# ---------- 地区访问限制与后台安全入口 ----------
# 以下 GEO_* 仅作为默认值：管理后台「系统配置 → 地区访问限制」保存后会覆盖这里的设置
# 设为 1 后只允许中国大陆 IP 访问（依据 server/assets/cn-ip-ranges.json 的 APNIC CN 段）
GEO_BLOCK_NON_CHINA=0
# 例外路径（逗号分隔）：健康检查、PWA 与开屏静态资源需要始终可访问
GEO_BYPASS_PATHS=/api/health,/theme-boot.js,/sw.js,/manifest.webmanifest,/favicon.ico
# 白名单 IP 或 CIDR（逗号分隔），例如运维出口固定 IP 或海外管理员
GEO_IP_WHITELIST=
# 归属未知时：deny = 拦截（默认），allow = 放行（数据缺失时避免整站不可用可临时改成 allow）
GEO_UNKNOWN_POLICY=deny
# 可选：CDN 回源的国家码请求头（如 CF-IPCountry）。仅在确认回源请求来自 CDN 时启用，否则可被伪造
GEO_TRUST_HEADER=
# 管理后台安全入口只在后台「系统配置 → 管理后台安全入口」设置（存数据库，无需环境变量）：
# 未设置时后台为 /admin；设置后入口变为 /<入口名>/admin，绕过入口直接访问会被记录并返回 404

# ---------- 开发与测试 ----------
# 仅本地/冒烟：把邮箱验证码回显到接口响应里，方便没配 SMTP 时完成注册与引导（生产环境请勿开启）
EMAIL_CODE_DEV_MODE=0
# 测试数据库路径（vitest 使用）
TEST_DATABASE_PATH=:memory:
